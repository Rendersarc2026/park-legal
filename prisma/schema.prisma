datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  username String  @unique
  password String
  isActive Boolean @default(true)
}

model Article {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  excerpt   String
  content   String?
  date      String
  category  String
  imageUrl  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  quote     String
  stars     Int      @default(5)
  author    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AboutSection {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  description String
  stats       Json     
  points      String[] 
  isActive    Boolean  @default(true)
}

model UploadedImage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  type      String
  data      Bytes
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model LoginAttempt {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  attempts  Int      @default(0)
  lockUntil DateTime?
  updatedAt DateTime @updatedAt
}

model ContactDetails {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  phone          String
  email          String
  address        String
  directionsLink String
  directContacts Json     // Array of { name: String, phone: String }
  isActive       Boolean  @default(true)
}

model Specialization {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  icon        String
  label       String
  description String
  details     String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}



